<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MultiplayerVC</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Codec -->
  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <!-- Unity references resolved via Directory.Build.targets (DvInstallDir/UnityInstallDir) -->
  <ItemGroup>
    <Reference Include="UnityEngine" />
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.AudioModule" />
    <Reference Include="UnityEngine.InputLegacyModule" />
    <Reference Include="UnityEngine.IMGUIModule" />
    <PackageReference Include="UnityModManager" Version="0.31.1" />
    <Reference Include="MultiplayerAPI">
      <HintPath>..\build\MultiplayerAPI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <!-- Copy the voice chat assembly to the repo build folder for convenience -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\build\" />
  </Target>

  <Target Name="CopyVcDependencies" AfterTargets="Build">
    <!-- Copy NuGet local-copy dependencies (e.g., Concentus.dll) to repo build and game mod folder -->
    <ItemGroup>
  <!-- Start from everything the build marked as CopyLocal -->
  <AllDeps Include="@(ReferenceCopyLocalPaths)" />
  <!-- Whitelist only Concentus libraries; Unity/System facades come from the game runtime -->
  <DepsToCopy Include="@(AllDeps)" Condition="'%(Filename)' == 'Concentus' or '%(Filename)' == 'Concentus.Native'" />
    </ItemGroup>
    <Copy SourceFiles="@(DepsToCopy)" DestinationFolder="..\build\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DepsToCopy)" DestinationFolder="$(DvInstallDir)\Mods\Multiplayer\" SkipUnchangedFiles="true" />
  </Target>
</Project>
